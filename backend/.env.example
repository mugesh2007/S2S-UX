# S2S ux (Sketch2Screen AI) - Backend Environment Configuration

# Application
PROJECT_NAME="Sketch2Screen AI"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=false
ENVIRONMENT="development"

# Server
HOST="0.0.0.0"
PORT=8000

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:3000"]
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
UPLOAD_DIR="/tmp/s2s_uploads"
CLEANUP_EPHEMERAL_FILES=true

# AI Provider Configuration
# Supported: "mock", "gemini"
VLM_PROVIDER="mock"
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.8-flash"
